                }
              ]
            }
          }
        },
        {
          "name": "Analyzed posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"responds under 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?user={{userEmail}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ],
              "query": [
                {
                  "key": "user",
                  "value": "{{userEmail}}"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Scores arrive (polls up to ~60 s)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const rows = body.comments || body.items || body;",
                  "const scored = rows.filter(r => r.vader_label || r.llm_label || r.label);",
                  "const tries = Number(pm.collectionVariables.get(\"pollTries\") || 0);",
                  "if (scored.length === 0 && tries < 12) {",
                  "  pm.collectionVariables.set(\"pollTries\", tries + 1);",
                  "  setTimeout(() => {}, 5000);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set(\"pollTries\", 0);",
                  "  pm.test(\"Spark scored the pasted comments\", () => pm.expect(scored.length).to.be.above(0));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/comments?post_id={{postId}}&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "comments"
              ],
              "query": [
                {
                  "key": "post_id",
                  "value": "{{postId}}"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Spark consumes `comments-analyze` and writes scores to PostgreSQL. Retries every 5 s, up to 12 times.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },

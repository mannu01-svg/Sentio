                  "const j = pm.response.json();",
                  "pm.test(\"status ok\", () => pm.expect(j.status).to.eql(\"ok\"));",
                  "pm.test(\"replayed from MongoDB\", () => pm.expect(j.source).to.eql(\"mongodb\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history/{{historyId}}/rehydrate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",

    {
      "name": "4 Analyze flow",
      "item": [
        {
          "name": "Analyze pasted comments",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"pasteTitle\", \"Postman run \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"responds under 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const j = pm.response.json();",
                  "pm.test(\"status ok\", () => pm.expect(j.status).to.eql(\"ok\"));",
                  "pm.test(\"3 comments published to Kafka\", () => pm.expect(j.comments_published).to.eql(3));",
                  "pm.test(\"keeps the given title\", () => pm.expect(j.post_title).to.eql(pm.collectionVariables.get(\"pasteTitle\")));",
                  "pm.collectionVariables.set(\"postId\", j.post_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analyze"
              ]
            },
            "description": "Pushes three comments to the `comments-analyze` Kafka topic and stores the raw text in MongoDB.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"Absolutely love it, best purchase this year!\\nCustomer support never replied, very disappointed.\\nIt arrived on Tuesday.\",\n  \"mode\": \"paste\",\n  \"limit\": 3,\n  \"title\": \"{{pasteTitle}}\",\n  \"user_email\": \"{{userEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "History (finds the new entry)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"responds under 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const j = pm.response.json();",
                  "const entries = j.entries || j.history || j;",
                  "const mine = entries.find(e => e.post_id === pm.collectionVariables.get(\"postId\"));",
                  "pm.test(\"new analysis is in history\", () => pm.expect(mine).to.be.an(\"object\"));",
                  "if (mine) pm.collectionVariables.set(\"historyId\", mine.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history?user={{userEmail}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "history"
              ],
              "query": [
                {
                  "key": "user",
                  "value": "{{userEmail}}"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "MongoDB document for the analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"responds under 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const j = pm.response.json();",
                  "pm.test(\"analysis document stored in MongoDB\", () => pm.expect(j.analysis).to.be.an(\"object\"));",
                  "pm.test(\"raw comments stored in MongoDB\", () => pm.expect(j.raw_count).to.eql(3));"
                ]
              }
            }

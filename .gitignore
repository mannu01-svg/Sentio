# Python
__pycache__/
*.py[cod]
.venv/
.venv-ci/
*.egg-info/
.pytest_cache/

# Spark
checkpoints/
spark-warehouse/
derby.log
metastore_db/

# Launcher logs & pids
logs/

# Data (derived CSVs are committed — 54MB total, see data/README.md)
data/raw/*.crc
data/raw/_SUCCESS
!data/raw/*.csv
!data/sample_comments.csv

# Model caches
.cache/

# Fine-tuned model: the 268MB safetensors blob stays local; its <=90MB
# .partNN chunks + .sha256 checksum are committed (split_weights.py --split/--join)
models/sentiment-finetuned/model.safetensors
models/training/checkpoints/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Deploy: TLS private key stays local (public cert is committed so a fresh
# clone serves HTTPS immediately; gen-certs.sh regenerates on demand)
deploy/nginx/certs/privkey.pem
deploy/certbot/

# Env & tools
.env
.env.local
.tools/

# Misc
*.log
.DS_Store
